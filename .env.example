# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 可直接使用官方 OpenAI API，也可使用任意 OpenAI-compatible provider
# 注意：ChatGPT Plus 订阅不等于 API 额度，API 需在 platform.openai.com 单独开通计费
#
# 方案 A：官方 OpenAI API（推荐用于直接接入 OpenAI）
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
#
# 你也可以使用标准变量名：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini
#
# 方案 B：其他 OpenAI-compatible provider（示例：阿里百炼 qwen-plus）
# 推荐使用阿里百炼平台 qwen-plus 模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 混合模型路由（可选）=====
# 用于“基础模型 + Premium模型”混合策略
# 如果基础和 Premium 使用同一个 provider / key，可以只填写 LLM_PREMIUM_MODEL_NAME
# LLM_PREMIUM_API_KEY 和 LLM_PREMIUM_BASE_URL 留空时会回退到基础配置
LLM_PREMIUM_API_KEY=
LLM_PREMIUM_BASE_URL=
LLM_PREMIUM_MODEL_NAME=
# 可选值: conservative | balanced | max_quality
LLM_ROUTING_PROFILE=balanced

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
